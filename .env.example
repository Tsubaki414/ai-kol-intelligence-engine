# ===========================================================
# Required credentials for the Python pipeline
# ===========================================================

# Anthropic — Claude API for classification, scoring, AI Agent
# Get at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-...

# X API v2 (formerly Twitter) — Basic tier (paid, $200/mo) required for
# /users/:id/following, /users/:id/tweets, /tweets/search/recent endpoints.
# Bearer token MUST be sent as-is (URL-encoded form kept — do NOT decode
# %2B or %3D characters, that causes 401).
X_BEARER_TOKEN=AAAAAAAAAAAAAAAAAAAAA...

# Optional: if you need to regenerate the bearer token yourself
# X_CONSUMER_KEY=
# X_CONSUMER_SECRET=

# ===========================================================
# Supabase (source of truth for users / follows / tweets)
# See supabase/SETUP.md for the 1-time setup
# ===========================================================

SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# service_role key — FULL ACCESS, bypasses RLS, server-only.
# Never expose this in browser code. Supabase supports both legacy JWT (eyJ...)
# and the newer sb_secret_* format. Either works.
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# anon key — read-only via RLS, safe for browser/React. Currently unused
# (frontend reads static JSON) but included for future dynamic loading.
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ===========================================================
# Optional — only needed for Phase 2 Layer 2 (On-chain) when implemented
# ===========================================================
# ETHERSCAN_API_KEY=
# ARKHAM_API_KEY=
# DUNE_API_KEY=

# GITHUB_TOKEN=  # optional, for developer KOL discovery
